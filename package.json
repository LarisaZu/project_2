{
  "name": "production_2",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "npx webpack serve --env port=3010",
    "start:dev:server": "node ./json-server/index.js",
    "start:dev": "concurrently \"npm start\" \"npm run start:dev:server\"",
    "build:prod": "npx webpack --env mode=production apiUrl=https://production2server-2fxyuzxhd-laras-projects-ddd3a49d.vercel.app",
    "build:dev": "npx webpack --env mode=development",
    "eslint:ts": "eslint \"**/*.{ts,tsx}\"",
    "eslint:ts:fix": "eslint \"**/*.{ts,tsx} --fix\"",
    "eslint:scss": "npx stylelint \"**/*.scss\"",
    "eslint:scss:fix": "npx stylelint \"**/*.scss\"",
    "test:unit": "jest --config './config/jest/jest.config.ts'",
    "test:ui": "npx loki --chromeConcurrency 1 test",
    "test:ui:ok": "npx loki approve",
    "test:ui:report": "npm run test:ui:json && npm run test:ui:html",
    "test:ui:json": "node scripts/generate-visual-json-report.js",
    "test:ui:html": "npx reg-cli --from .loki/report.json --report .loki/report.html",
    "test:ui:ci": "npx loki --requireReference --reactUri file:./storybook-static",
    "storybook": "storybook dev -p 6006 -c ./config/storybook",
    "storybook:build": "storybook build -c ./config/storybook",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
